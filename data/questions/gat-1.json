  { "id": "gat_001", "section": "general", "subject": "General Test", "topic": "Logical Reasoning", "difficulty": "easy", "question": "Find the next number in the series: 2, 5, 10, 17, ?", "options": ["24", "26", "25", "27"], "correctIndex": 1, "explanation": "Pattern: n² + 1. (1²+1=2, 2²+1=5, 3²+1=10, 4²+1=17). Next: 5²+1 = 26.", "source": "sample", "tags": ["series"] },
